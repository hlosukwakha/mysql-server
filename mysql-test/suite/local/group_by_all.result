CREATE TABLE t1 (
a INT,
b INT,
c INT
) ENGINE=InnoDB;
INSERT INTO t1 VALUES
(1, 10, 100),
(1, 20, 100),
(2, 30, 200),
(2, 30, 200);
SELECT a, b, SUM(c) FROM t1 GROUP BY ALL ORDER BY a, b;
a	b	SUM(c)
1	10	100
1	20	100
2	30	400
SELECT a, SUM(c), b FROM t1 GROUP BY ALL ORDER BY a, b;
a	SUM(c)	b
1	100	10
1	100	20
2	400	30
SELECT a, SUM(b), c FROM t1 GROUP BY ALL ORDER BY a, c;
a	SUM(b)	c
1	30	100
2	60	200
SELECT a, SUM(b), SUM(c) FROM t1 GROUP BY ALL ORDER BY a;
a	SUM(b)	SUM(c)
1	30	200
2	60	400
DROP TABLE t1;
